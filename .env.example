# Copy to .env (gitignored) and fill in your Skyward Family Access login.
# Your district's Family Access host, e.g. https://skyward.yourdistrict.org
# (never the site root path; the client adds /Student/... itself)
SKYWARD_BASE_URL=
SKYWARD_USER=
SKYWARD_PASS=

# When to fetch from Skyward (cron syntax, in the container's TZ). Skyward
# allows one session per account, so each sync may sign you out of Skyward
# in your browser.
# SKYWARD_SYNC_CRON=0 6-21/3 * * *
